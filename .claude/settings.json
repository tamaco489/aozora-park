{
  "enabledMcpjsonServers": ["context7"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-commit-message.py",
            "statusMessage": "コミットメッセージを検査中"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "mcp__github__list_pull_requests",
      "mcp__github__create_pull_request",
      "mcp__github__issue_read",
      "mcp__github__issue_write",
      "mcp__github__add_issue_comment",
      "mcp__github__get_me"
    ]
  }
}
