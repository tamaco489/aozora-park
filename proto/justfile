default:
    @just --list


# ==========================================================================================
# buf: 静的検査と整形
# ==========================================================================================
# 規約の検査
lint:
    buf lint

# 整形
fmt:
    buf format -w

# 整形漏れの検査
fmt-check:
    buf format --diff --exit-code


# ==========================================================================================
# buf: コードとドキュメントの生成
# ==========================================================================================
# Go と TypeScript のコードと OpenAPI を生成する
generate:
    ./scripts/generate.sh

# docs/api/openapi.yaml から Redoc の HTML を生成する (proto を変更したら流して一緒にコミットする)
docs:
    ./scripts/build-docs.sh
