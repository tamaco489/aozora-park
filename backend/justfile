# run-api はコンテナの firestore-emulator に向ける、demo- で始まる ID は本物の GCP への接続を拒む
emulator_env := "FIRESTORE_EMULATOR_HOST=localhost:18080 GOOGLE_CLOUD_PROJECT=demo-aozora-park"

default:
    @just --list

# 依存の整理
tidy:
    go mod tidy

# ビルド
build:
    go build ./...

# テスト (エミュレータが要るものは飛ばされる)
test:
    go test ./...

# エミュレータ相手のテストも含めて実行する (テストが Docker でエミュレータを起動します)
test-emulator:
    DOCKER_TESTS=1 go test ./...

# 静的解析
vet:
    go vet ./...

# 整形
fmt:
    go fmt ./...

# 整形漏れの検査
fmt-check:
    gofmt -l .

# modernize の提案を出す (gen/ は手で直せないため外す)
modernize:
    go run golang.org/x/tools/gopls/internal/analysis/modernize/cmd/modernize@latest ./cmd/... ./internal/...

# api をローカルで起動する
run-api:
    {{ emulator_env }} go run ./cmd/api

# ヘルスチェックを呼ぶ、api を起動した状態で実行する
health port="8080":
    buf curl --http2-prior-knowledge -d '{"service":""}' http://localhost:{{port}}/grpc.health.v1.Health/Check
