# run-api はコンテナの firestore-emulator に向ける、demo- で始まる ID は本物の GCP への接続を拒む
emulator_env := "FIRESTORE_EMULATOR_HOST=localhost:18080 GOOGLE_CLOUD_PROJECT=demo-aozora-park"

# Vite の開発サーバの既定のオリジン、設定しないとブラウザからの呼び出しがプリフライトで落ちる
cors_env := "CORS_ALLOWED_ORIGINS=http://localhost:5173"

# run-api-stg は stg の Firestore に ADC で繋ぐ、課金先は ADC の quota project に左右されないよう stg に固定する
stg_env := "GOOGLE_CLOUD_PROJECT=stg-aozora-park GOOGLE_CLOUD_QUOTA_PROJECT=stg-aozora-park"

default:
    @just --list


# ==========================================================================================
# go: 依存とビルド
# ==========================================================================================
# 依存の整理
tidy:
    go mod tidy

# ビルド
build:
    go build ./...


# ==========================================================================================
# go: テスト
# ==========================================================================================
# テスト (エミュレータが要るものは飛ばされる)
test:
    go test ./...

# エミュレータ相手のテストも含めて実行する (テストが Docker でエミュレータを起動します)
test-emulator:
    DOCKER_TESTS=1 go test ./...


# ==========================================================================================
# go: 静的検査と整形
# ==========================================================================================
# 静的解析
vet:
    go vet ./...

# 規約の検査 (依存の向きは depguard が見る)
lint:
    golangci-lint run ./...

# 整形
fmt:
    go fmt ./...

# 整形漏れの検査
fmt-check:
    gofmt -l .


# ==========================================================================================
# api: ローカルでの起動と確認
# ==========================================================================================
# api をエミュレータに向けて起動する (先にルートで just up を実行する)
run-api:
    {{ emulator_env }} {{ cors_env }} go run ./cmd/api

# api を stg の Firestore に向けて起動する (ADC が必要)、シェルに残ったエミュレータの設定は外す
run-api-stg:
    env -u FIRESTORE_EMULATOR_HOST {{ stg_env }} {{ cors_env }} go run ./cmd/api

# ヘルスチェックを呼ぶ、api を起動した状態で実行する
health port="8080":
    buf curl --http2-prior-knowledge -d '{"service":""}' http://localhost:{{port}}/grpc.health.v1.Health/Check


# ==========================================================================================
# docker: コンテナでの起動と確認
# ==========================================================================================
# api のイメージをローカルでビルドする
docker-build:
    docker build --build-arg SERVICE=api -t aozora-park/api:local .

# ビルドしたイメージをエミュレータに向けて起動する (先にルートで just up を実行する)、コンテナから見たホストのエミュレータに繋ぐ
docker-run: docker-build
    docker run --rm --detach --name aozora-park-api -p 8080:8080 \
        -e FIRESTORE_EMULATOR_HOST=host.docker.internal:18080 \
        -e GOOGLE_CLOUD_PROJECT=demo-aozora-park \
        -e CORS_ALLOWED_ORIGINS=http://localhost:5173 \
        aozora-park/api:local

# docker-run で起動したコンテナを停止する、--rm で起動しているため停止と同時に破棄される
docker-stop:
    docker stop aozora-park-api


# ==========================================================================================
# deploy: stg への手動デプロイ
# ==========================================================================================
# stg へデプロイする (例: just deploy-stg release/main-issue-54/api-deploy)
#
# 指定した ref のコミットを Cloud Build がビルドし、Cloud Run の api を差し替える
# ソースは GitHub から Developer Connect 経由で取得するため、手元の変更は反映されない
# イメージのタグにはコミットの SHA を使う
[doc("stg へデプロイする (既定の ref は main)")]
deploy-stg ref="main":
    ./scripts/deploy-stg.sh {{ ref }}
