# run-api はコンテナのエミュレータに向ける、demo- で始まる ID は本物の GCP への接続を拒む
emulator_env := "FIRESTORE_EMULATOR_HOST=localhost:18080 PUBSUB_EMULATOR_HOST=localhost:18085 GOOGLE_CLOUD_PROJECT=demo-aozora-park"

# run-api-stg は stg の Firestore と Pub/Sub に ADC で繋ぐ、課金先は ADC の quota project に左右されないよう stg に固定する
stg_env := "GOOGLE_CLOUD_PROJECT=stg-aozora-park GOOGLE_CLOUD_QUOTA_PROJECT=stg-aozora-park"

default:
    @just --list


# ==========================================================================================
# go: 依存とビルド
# ==========================================================================================
# 依存の整理
tidy:
    go mod tidy

# ビルド
build:
    go build ./...


# ==========================================================================================
# go: テスト
# ==========================================================================================
# テスト (エミュレータが要るものは飛ばされる)
test:
    go test ./...

# エミュレータ相手のテストも含めて実行する (テストが Docker でエミュレータを起動します)
test-emulator:
    DOCKER_TESTS=1 go test ./...


# ==========================================================================================
# go: 静的検査と整形
# ==========================================================================================
# 静的解析
vet:
    go vet ./...

# 規約の検査 (依存の向きは depguard が見る)
lint:
    golangci-lint run ./...

# 整形
fmt:
    go fmt ./...

# 整形漏れの検査
fmt-check:
    gofmt -l .


# ==========================================================================================
# api: ローカルでの起動と確認
# ==========================================================================================
# api をエミュレータに向けて起動する (先にルートで just up を実行する)
run-api:
    {{ emulator_env }} go run ./cmd/api

# api を stg に向けて起動する (ADC が必要)、シェルに残ったエミュレータの設定は外す
run-api-stg:
    env -u FIRESTORE_EMULATOR_HOST -u PUBSUB_EMULATOR_HOST {{ stg_env }} go run ./cmd/api

# ヘルスチェックを呼ぶ、api を起動した状態で実行する
health port="8080":
    buf curl --http2-prior-knowledge -d '{"service":""}' http://localhost:{{port}}/grpc.health.v1.Health/Check


# ==========================================================================================
# docker: コンテナでの起動と確認
# ==========================================================================================
# api のイメージをローカルでビルドする
docker-build:
    docker build --build-arg SERVICE=api -t aozora-park/api:local .

# ビルドしたイメージをエミュレータに向けて起動する (先にルートで just up を実行する)、コンテナから見たホストのエミュレータに繋ぐ
docker-run: docker-build
    docker run --rm --detach --name aozora-park-api -p 8080:8080 \
        -e FIRESTORE_EMULATOR_HOST=host.docker.internal:18080 \
        -e PUBSUB_EMULATOR_HOST=host.docker.internal:18085 \
        -e GOOGLE_CLOUD_PROJECT=demo-aozora-park \
        aozora-park/api:local

# docker-run で起動したコンテナを停止する、--rm で起動しているため停止と同時に破棄される
docker-stop:
    docker stop aozora-park-api


# ==========================================================================================
# deploy: stg への手動デプロイ
# ==========================================================================================
# stg の Firestore に枠を作成する
#
# 今日から inventoryDays 日分の dateInventories と timeSlots を作る。既にあるものは作らない
# priorityPassConfig.enabled が true のアトラクションだけが対象になる
# 定期実行の仕組み (Cloud Run jobs と Scheduler) がまだ無いため、当面は手で実行する
[doc("stg の Firestore に枠を作成する")]
generate-inventory-stg:
    env -u FIRESTORE_EMULATOR_HOST -u PUBSUB_EMULATOR_HOST {{ stg_env }} go run ./cmd/job generate

# stg の api へデプロイする (例: just deploy-api-stg main)
#
# 指定した ref のコミットを Cloud Build がビルドし、Cloud Run の api を差し替える
# ref は省略できない、どのコミットが stg に出るかを取り違えないため
# ソースは GitHub から Developer Connect 経由で取得するため、手元の変更は反映されない
# イメージのタグにはコミットの SHA を使う
[doc("stg の api へデプロイする (ref は必須)")]
deploy-api-stg ref:
    ./scripts/deploy-api-stg.sh {{ ref }}

# stg の priority-pass-issuer へデプロイする (例: just deploy-priority-pass-issuer-stg main)
#
# デプロイしたいサービスだけを指定する、まとめて出すレシピは置かない
# main へのマージでは CD がサービスごとのワークフローで両方を配信する
[doc("stg の priority-pass-issuer へデプロイする (ref は必須)")]
deploy-priority-pass-issuer-stg ref:
    ./scripts/deploy-priority-pass-issuer-stg.sh {{ ref }}
